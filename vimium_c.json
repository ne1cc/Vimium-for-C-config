{
	"name": "Vimium C",
	"environment": {
		"extension": "2.13.1",
		"platform": "linux",
		"chromium": 154
	},
	"allBrowserUrls": true,
	"grabBackFocus": true,
	"hideHud": true,
	"keyLayout": 2,
	"keyMappings": [
		"#!no-check",
		"# ==============================================================================",
		"# Global & Key Translations",
		"# ==============================================================================",
		"mapKey <c-c:i> <esc>",
		"",
		"# ==============================================================================",
		"# Page Navigation & Scrolling",
		"# ==============================================================================",
		"map gg scrollToTop",
		"map G scrollToBottom",
		"map d scrollPageDown",
		"map <c-d> scrollFullPageDown",
		"map <c-u> scrollFullPageUp",
		"",
		"# ==============================================================================",
		"# Zoom & View Controls",
		"# ==============================================================================",
		"map q zoomIn",
		"map w zoomOut",
		"map z zoomReset",
		"map Z zoom count=70",
		"map <a-z> zoom count=150",
		"map R toggleReaderMode",
		"",
		"# ==============================================================================",
		"# Find & Search Mode",
		"# ==============================================================================",
		"map n performFind",
		"map b performBackwardsFind",
		"",
		"# ==============================================================================",
		"# Link Hints & Media",
		"# ==============================================================================",
		"map f LinkHints.activate button=\"\\\"\\\"/right,\" touch=\"false/true/\\\"auto\\\"\"",
		"map ; LinkHints.activateOpenInNewForegroundTab",
		"map e LinkHints.activateWithQueue",
		"map E LinkHints.activate newtab=\"window\"",
		"map I LinkHints.activateOpenImage",
		"map <a-d> LinkHints.activateDownloadImage",
		"",
		"# ==============================================================================",
		"# Vomnibar & Opening URLs",
		"# ==============================================================================",
		"unmap o",
		"map o Vomnibar.activateInNewTab itemKeyword=\"ow\"",
		"map ga autoOpen",
		"",
		"# ==============================================================================",
		"# Clipboard & Capture",
		"# ==============================================================================",
		"map c autoCopy",
		"map yy copyCurrentUrl type=\"url\" decoded",
		"map ye copyWindowInfo use format=\"\\\"${title}\\\":\\n\\t•\\u0020${url}\\n\" join:true/string, decoded",
		"unmap 0",
		"map 0 captureTab",
		"",
		"# ==============================================================================",
		"# Tab Navigation & Management",
		"# ==============================================================================",
		"map <c-s-left> moveTabLeft",
		"map <c-s-right> moveTabRight",
		"map <s-left> previousTab",
		"map <s-right> nextTab",
		"map <a-[> previousTab",
		"map <a-]> nextTab",
		"map <a-,> moveTabLeft group=\"True\" count=99",
		"map <a-.> moveTabRight group=\"True\" count=99",
		"map <a-p> togglePinTab",
		"map gx closeOtherTabs",
		"map S sortTabs sort=\"recency|createTime\"",
		"map Q joinTabs",
		"",
		"# ==============================================================================",
		"# Audio & Media Controls",
		"# ==============================================================================",
		"map <s-f10> toggleMuteTab",
		"map M toggleMuteTab all",
		"",
		"# ==============================================================================",
		"# Window Controls & Transitions",
		"# ==============================================================================",
		"map F toggleWindow states=\"normal\\u0020maximized\"",
		"map W moveTabToNextWindow group",
		"map N moveTabToNewWindow group",
		"map ! moveTabToIncognito",
		"",
		"# ==============================================================================",
		"# Marks",
		"# ==============================================================================",
		"map <f1> Marks.clearLocal",
		"map <f2> Marks.clearGlobal",
		""
	],
	"keyupTime": 125,
	"linkHintCharacters": "sadjklwcmpghr",
	"searchEngines": [
		"ow: vimium://run/openUrl#reuse=new-wnd&url=${s:%20}"
	],
	"vimSync": true,
	"vomnibarOptions": {
		"actions": "icase",
		"maxMatches": 25,
		"queryInterval": 333,
		"sizes": "88,3,44,0.8,1944",
		"styles": "absolute-time"
	},
	"waitForEnter": false
}
